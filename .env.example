# Copy to `.env` and adjust before first start:
#   cp .env.example .env
# `.env` is git-ignored, so secrets never land in the repo.
#
# !! SET THE PASSWORD BEFORE THE FIRST START !!
# Postgres writes the password into its data directory when it initializes an
# EMPTY volume, and never reads POSTGRES_PASSWORD again. Editing it afterwards
# does NOT change the database - the app just starts failing with
# "password authentication failed for user". To change it on a live install:
#   docker compose exec postgres psql -U "$POSTGRES_USER" -d "$POSTGRES_DB" \
#     -c "ALTER USER \"$POSTGRES_USER\" WITH PASSWORD 'new-password';"
#   # then put the same value in .env and: docker compose up -d
# (Or wipe everything and start over: docker compose down -v — DELETES all
# raffle data.)
#
# NOTE: keep the password URL-safe (letters, digits, - _ . ~). Characters
# like @ : / ? # must be percent-encoded or DATABASE_URL breaks.
#
# The defaults below match the values this project shipped with originally, so
# existing installs keep working if you leave .env alone. They are NOT safe for
# anything reachable from a network - change them on a fresh install.

POSTGRES_DB=raffle
POSTGRES_USER=user
POSTGRES_PASSWORD=pass

# Host port the app is reachable on.
RAFFLE_PORT=8543

# Where Postgres stores its data. Leave unset for a plain Docker volume, or
# point at a host path (e.g. a NAS dataset) so snapshots/backups cover it:
# PGDATA_DIR=/mnt/tank/apps/goraffle/pgdata
